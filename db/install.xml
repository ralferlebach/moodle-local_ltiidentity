<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/ltiidentity/db" VERSION="2026042200" COMMENT="XMLDB file for local_ltiidentity"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_ltiidentity_override" COMMENT="Local overrides for LTI-authenticated users.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="firstnameoverride" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="lastnameoverride" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="emailoverride" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="namepolicy" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="fallback"/>
        <FIELD NAME="emailpolicy" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="lti"/>
        <FIELD NAME="managedby" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="source" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="self"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="useriduniq" TYPE="unique" FIELDS="userid"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_ltiidentity_mailtoken" COMMENT="Pending email verification tokens.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="emailcandidate" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="tokenhash" TYPE="char" LENGTH="128" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="expiresat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="consumedat" TYPE="int" LENGTH="10" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_ltiidentity_namerule" COMMENT="Global name rules for anonymous or incomplete LTI logins.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="firstnamepattern" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="lastnamepattern" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="isdefault" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_ltiidentity_audit" COMMENT="Audit trail for local identity changes.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="action" TYPE="char" LENGTH="50" NOTNULL="true"/>
        <FIELD NAME="detailsjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
