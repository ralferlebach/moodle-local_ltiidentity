<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/ltiidentity/db" VERSION="2026102700" COMMENT="XMLDB file for Moodle local/ltiidentity"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_ltiidentity_audit" COMMENT="Audit trail of profile changes and lock releases. Stores field names and flags only, never names or e-mail addresses.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User who performed the action (0 after anonymisation)"/>
        <FIELD NAME="targetuserid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User whose profile was changed"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Context in which the action was performed"/>
        <FIELD NAME="action" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false" COMMENT="update, release, emailrequest, emailverify"/>
        <FIELD NAME="fieldnames" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Comma separated names of the profile fields concerned"/>
        <FIELD NAME="oldflag" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false" COMMENT="Lock or policy state before the action"/>
        <FIELD NAME="newflag" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false" COMMENT="Lock or policy state after the action"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="targetuser" UNIQUE="false" FIELDS="targetuserid"/>
        <INDEX NAME="actor" UNIQUE="false" FIELDS="actorid"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
